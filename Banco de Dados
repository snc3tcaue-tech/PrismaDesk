create table chamados (
id_chamado int primary key not null auto_increment,

id_cliente int not null,
id_tecnico int,

categoria enum ('hardware','impressoras',
'software','redes',
'servidores','suporte'),
prioridade enum ('alta','média','baixa'),
titulo varchar (50),
descricao varchar (255),
status_chamado enum ('aberto','em andamento','fechado'),

data_abertura timestamp default current_timestamp, 
data_fechamento timestamp null,

foreign key (id_cliente) references clientes(id_cliente) on delete cascade,
foreign key (id_tecnico) references tecnicos(id_tecnico) on delete set null
);
